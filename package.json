{
  "name": "ragnarok-new-world-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "names:sync": "node scripts/standardize-index-names.mjs",
    "social:sync": "node scripts/sync-social-images.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:audit:strict": "node scripts/seo-audit.mjs --strict",
    "indexnow:verify": "node scripts/indexnow-verify.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "indexnow:submit:all": "node scripts/indexnow-submit.mjs --all",
    "indexnow:dry-run": "node scripts/indexnow-submit.mjs --all --dry-run",
    "skills:sync:preview": "node scripts/sync-roworlddb-skills.mjs",
    "skills:sync:apply": "node scripts/sync-roworlddb-skills.mjs --apply",
    "skills:compare:hmt": "node scripts/compare-roworlddb-hmt-skills.mjs",
    "skills:overlay:hmt": "node scripts/apply-hmt-skill-overlay.mjs",
    "tools:data:sync:preview": "node scripts/sync-roworlddb-tools.mjs",
    "tools:data:sync:apply": "node scripts/sync-roworlddb-tools.mjs --apply",
    "data:sync:build": "node scripts/build-data-sync.mjs",
    "skills:locale:version": "node scripts/version-skill-locale-assets.mjs",
    "tools:locales:enable": "node scripts/enable-sea-locales.mjs",
    "predev": "npm run tools:locales:enable && npm run skills:overlay:hmt && npm run skills:locale:version && npm run names:sync && npm run social:sync && npm run seo:audit",
    "dev": "vite",
    "prebuild": "npm run tools:locales:enable && npm run data:sync:build && npm run skills:locale:version && npm run names:sync && npm run social:sync && npm run seo:audit",
    "build": "node scripts/generate-performance-data.mjs && vite build",
    "postbuild": "node scripts/indexnow-submit.mjs --auto --nonfatal",
    "preview": "npm run build && vite preview",
    "start": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:full": "npm run build && npm run deploy",
    "data:optimize": "node scripts/generate-performance-data.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Ragnarok: The New World Game Hub"
}
