# Search-engine ownership verification
# Paste only the token value from each provider's HTML meta-tag method.
# These identifiers are emitted as public verification meta tags during deployment.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow deployment controls
# Automatic submission is enabled unless this is explicitly set to 0.
INDEXNOW_AUTO_SUBMIT=1
# Set to 1 for one deployment when the complete sitemap should be submitted.
INDEXNOW_SUBMIT_ALL=0
# Optional overrides; the committed public key works without these values.
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
