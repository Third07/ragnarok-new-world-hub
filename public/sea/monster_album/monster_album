        <main class="main-content">
            <div class="simulator-layout monster-layout">
                <section class="monster-panel">
                    <div class="monster-toolbar">
                        <div class="monster-search-row">
                            <input id="monster-search" class="monster-search" type="search"
                                placeholder="搜尋魔物或掉落（道具: 名稱）..." autocomplete="off"
                                spellcheck="false" />
                            <div id="monster-count" class="monster-count">載入中...</div>
                        </div>
                        <div class="monster-filter-row">
                            <label class="monster-filter-toggle">
                                <input id="monster-handbook" type="checkbox">
                                <span>顯示全部（實驗中）</span>
                            </label>
                        </div>
                        <div class="monster-filter-row monster-filter-row--selectors">
                            <label class="monster-filter-select">
                                <span>活動</span>
                                <select id="monster-filter-activity">
                                    <option value="">無</option>
                                    <option value="時空迴廊">時空迴廊</option>
                                    <option value="時淵迴響">時淵迴響</option>
                                    <option value="異界入侵">異界入侵</option>
                                    <option value="鏡像世界">鏡像世界</option>
                                </select>
                            </label>
                            <label class="monster-filter-select">
                                <span>屬性</span>
                                <select id="monster-filter-element">
                                    <option value="">全部</option>
                                </select>
                            </label>
                            <label class="monster-filter-select">
                                <span>種族</span>
                                <select id="monster-filter-race">
                                    <option value="">全部</option>
                                </select>
                            </label>
                            <label class="monster-filter-select">
                                <span>體型</span>
                                <select id="monster-filter-body">
                                    <option value="">全部</option>
                                </select>
                            </label>
                            <label class="monster-filter-select">
                                <span>類型</span>
                                <select id="monster-filter-type">
                                    <option value="">全部</option>
                                </select>
                            </label>
                        </div>
                    </div>

                    <div id="monster-list" class="monster-list"></div>
                    <div id="monster-sentinel" class="monster-sentinel"></div>
                </section>

                <aside id="monster-detail" class="monster-detail">
                    <div class="monster-detail-empty">
                        請選擇魔物查看屬性與掉落。
                    </div>
                </aside>
            </div>
        </main>
    </div>

    <div class="refine-modal monster-detail-modal" id="monster-detail-modal" aria-hidden="true" inert>
        <div class="refine-modal-backdrop" data-monster-modal-close></div>
        <div class="refine-modal-card" role="dialog" aria-modal="true" aria-labelledby="monster-detail-modal-title">
            <div class="refine-modal-header">
                <h3 id="monster-detail-modal-title">Monster Details</h3>
                <button class="refine-modal-close" type="button" data-monster-modal-close aria-label="Close">×</button>
            </div>
            <div class="refine-modal-body">
                <div id="monster-detail-modal-content" class="monster-detail monster-detail--modal"></div>
