    <script>
        (function () {
            const SUPPORTED_LOCALES = ["zh-TW", "en-US", "zh-CN", "th-TH", "id-ID"];
            const STRINGS = {
                "en-US": { shareBuild: "Share build", copyShareLink: "Copy share link" },
                "zh-TW": { shareBuild: "\u5206\u4eab\u914d\u7f6e", copyShareLink: "\u8907\u88fd\u5206\u4eab\u9023\u7d50" },
                "zh-CN": { shareBuild: "\u5206\u4eab\u914d\u7f6e", copyShareLink: "\u590d\u5236\u5206\u4eab\u94fe\u63a5" },
                "th-TH": { shareBuild: "Share build", copyShareLink: "Copy share link" },
                "id-ID": { shareBuild: "Share build", copyShareLink: "Copy share link" }
            };
            function detectLocale() {
                const queryLocale = new URLSearchParams(window.location.search).get("lang");
                const storedLocale = localStorage.getItem("ro_lang");
                const htmlLocale = document.documentElement.getAttribute("lang");
                const browserLocales = Array.isArray(navigator.languages) ? navigator.languages : [];
                const candidates = [queryLocale, storedLocale, htmlLocale, navigator.language || "", ...browserLocales];
                for (const candidate of candidates) {
                    if (!candidate) continue;
                    const match = SUPPORTED_LOCALES.find((locale) => locale.toLowerCase() === String(candidate).trim().toLowerCase());
                    if (match) return match;
                }
                for (const candidate of candidates) {
                    if (!candidate) continue;
                    const language = String(candidate).split("-")[0].toLowerCase();
                    if (language === "zh") return "zh-TW";
                    if (language === "en") return "en-US";
                    if (language === "th") return "th-TH";
                    if (language === "id" || language === "in") return "id-ID";
                }
                return "en-US";
            }
            const locale = detectLocale();
            const text = STRINGS[locale] || STRINGS["en-US"];
            const shareButton = document.getElementById("share-link-btn");
            if (shareButton) {
                shareButton.title = text.copyShareLink;
                shareButton.setAttribute("aria-label", text.copyShareLink);
                const label = shareButton.querySelector(".site-nav-label");
                if (label) label.textContent = text.shareBuild;
            }
        })();
    </script>
